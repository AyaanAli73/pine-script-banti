
//@version=5
indicator("Service and Success Tool", overlay=true)

// Trend calculations
ema20 = ta.ema(close, 20)
plot(ema20, color=color.new(color.blue, 50), title="Trend Line")

// Market Logic
vol_avg = ta.sma(volume, 20)
high_vol = volume > vol_avg
buy_cond = (close > ema20) and (close > open) and high_vol
sell_cond = (close < ema20) and (close < open) and high_vol

// Signal Plotting
plotshape(buy_cond, style=shape.labelup, location=location.belowbar, color=color.green, size=size.normal, text="BUY", textcolor=color.white)
plotshape(sell_cond, style=shape.labeldown, location=location.abovebar, color=color.red, size=size.normal, text="SELL", textcolor=color.white)
